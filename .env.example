# DBrain Module 7 RAG — environment template.
# Copy to `.env` and fill in your values. Never commit the real `.env`.

# --- Groq (primary LLM — standardised per scope decision) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# MAX_OUTPUT_TOKENS=2048
# TEMPERATURE=0.0

# --- Alternative LLM providers (optional, overridden by GROQ_API_KEY) ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
USE_OLLAMA=false
OLLAMA_MODEL=

# --- Embeddings (local = all-MiniLM-L6-v2 ONNX, offline, default) ---
# EMBEDDING_PROVIDER=local | jina | gemini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Only needed when EMBEDDING_PROVIDER=jina (funded key):
JINA_API_KEY=

# --- Langfuse observability ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Paths ---
CHROMA_PERSIST_DIR=./chroma_db_local
DOCS_DIR=./data/db_docs

# --- Retrieval / reranking ---
# TOP_K_DEFAULT=10
# RERANK_TOP_K=5
# RELEVANCE_THRESHOLD=0.15
# Absolute evidence gate on the best dense cosine similarity (off-topic → refuse).
# MIN_SEMANTIC_SIMILARITY=0.35
# GUARDRAIL_ENABLED=true
# Cross-encoder reranker; loads torch (~300MB RAM). Set false on 512MB hosts.
# RERANKER_ENABLED=true

# --- API / security ---
# Only needed when the UI is served from a different origin (npm start on :3000).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Admin key for diagnose / approve / apply / listings. Public Q&A stays open.
# Leave empty for local development.
API_KEY=
# Per-IP request budget for /query and /diagnose (0 disables).
# RATE_LIMIT_PER_MINUTE=20

# --- Logging ---
# LOG_LEVEL=INFO

# =============================================================================
# DBrain v2 — Live Diagnostic Agent  (Phase 2+)
# =============================================================================
# READ-ONLY credentials — used by inspectors. Never grants writes to the DB.
# PG_DIAG_DSN=postgresql://readonly:pass@localhost:5432/mydb
# MYSQL_DIAG_DSN=mysql+pymysql://readonly:pass@localhost:3306/mydb
# MONGO_DIAG_URI=mongodb://readonly:pass@localhost:27017
# MONGO_DIAG_DB=mydb

# APPLY credentials — used ONLY after human approval (HITL gate).
# Use schema-owner or a user with CREATE INDEX permission only.
# PG_APPLY_DSN=postgresql://app_owner:pass@localhost:5432/mydb
# MYSQL_APPLY_DSN=mysql+pymysql://app_owner:pass@localhost:3306/mydb
# MONGO_APPLY_URI=mongodb://app_owner:pass@localhost:27017